FROM python:3.12.10-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PYTHON_DOWNLOADS=never \
    PATH="/app/.venv/bin:$PATH"
WORKDIR /app
RUN pip install --no-cache-dir uv==0.9.8
COPY pyproject.toml uv.lock ./
COPY apps/api/pyproject.toml apps/api/pyproject.toml
COPY apps/voice-worker/pyproject.toml apps/voice-worker/pyproject.toml
RUN uv sync --frozen --all-packages --no-dev --no-install-workspace
COPY apps ./apps
COPY alembic.ini ./
RUN uv sync --frozen --all-packages --no-dev
RUN useradd --uid 10001 --create-home appuser && chown -R appuser:appuser /app
USER appuser

