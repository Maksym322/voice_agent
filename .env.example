# Copy to .env and set BOTH required values with a unique local password.
# URL-encode special characters in DATABASE_URL's password.
POSTGRES_PASSWORD=
DATABASE_URL=
APP_ORIGIN=http://localhost:8080
ENVIRONMENT=local
SESSION_SECURE_COOKIE=false
SESSION_LIFETIME_MINUTES=480
WEB_PORT=8080
DB_PORT=5433

# Optional VF-003 media settings. Keep the real key and secret only in ignored .env.
LIVEKIT_URL=
LIVEKIT_BROWSER_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
PLAYGROUND_MAX_SECONDS=600

# VF-005 outbound test. Configure the trunk in LiveKit first. The destination
# must be your own +380 number; only admins can trigger a call from the UI.
OUTBOUND_SIP_TRUNK_ID=
OUTBOUND_TEST_DESTINATION=
OUTBOUND_TEST_MAX_SECONDS=180
# Carrier's documented SIP origination IPs/CIDRs, comma-separated. Required
# only when adding an inbound number; do not guess these values.
INBOUND_SIP_ALLOWED_ADDRESSES=

# Provisional direct-provider preset for a separate paid live smoke test.
# Leave empty for synthetic checks. Never commit populated values.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
# Only required when a published agent selects Google Gemini as its LLM.
GOOGLE_API_KEY=
CARTESIA_API_KEY=

# Per-installation console presentation; no session state is changed by these.
CONSOLE_BRAND_NAME=Voice Fleet
CONSOLE_ACCENT_COLOR=#0b5960
CONSOLE_DEFAULT_GROUPS=pending,active,error,ended
CONSOLE_VISIBLE_MODULES=overview,board,history,agents,numbers,logs,settings
